-- Remote payload validation and rate limiting (anti-exploit building blocks).

return function(t)
	local describe, it, expect = t.describe, t.it, t.expect
	local roblox = require("@lune/roblox")
	local loader = t.loader()
	local Guard = loader:require("src/ReplicatedStorage/Source/Shared/Guard.luau")
	local RateLimiter = loader:require("src/ServerScriptService/Source/Modules/RateLimiter.luau")

	describe("Guard", function()
		it("accepts only finite numbers in range", function()
			expect(Guard.Number(5)).toBe(5)
			expect(Guard.Number(0 / 0)).toBeNil()
			expect(Guard.Number(math.huge)).toBeNil()
			expect(Guard.Number(-math.huge)).toBeNil()
			expect(Guard.Number("5")).toBeNil()
			expect(Guard.Number(11, 0, 10)).toBeNil()
			expect(Guard.Integer(3.5)).toBeNil()
			expect(Guard.Integer(3)).toBe(3)
		end)
		it("validates strings and options", function()
			expect(Guard.String("Rope", 8)).toBe("Rope")
			expect(Guard.String("", 8)).toBeNil()
			expect(Guard.String(string.rep("a", 9), 8)).toBeNil()
			expect(Guard.String("\255\254", 8)).toBeNil()
			expect(Guard.OneOf("GroundLash", { "GroundLash", "AerialSweep" })).toBe("GroundLash")
			expect(Guard.OneOf("Nuke", { "GroundLash", "AerialSweep" })).toBeNil()
			expect(Guard.Key("HempCord", { HempCord = true })).toBe("HempCord")
			expect(Guard.Key("__index", { HempCord = true })).toBeNil()
		end)
		it("validates vectors and directions", function()
			local direction = Guard.Direction(roblox.Vector3.new(0, 0, -5))
			expect(direction.Z).toBeNear(-1)
			expect(Guard.Direction(roblox.Vector3.new(0, 0, 0))).toBeNil()
			expect(Guard.Direction(roblox.Vector3.new(0 / 0, 0, 1))).toBeNil()
			expect(Guard.Direction({ X = 1, Y = 0, Z = 0 })).toBeNil()
			expect(Guard.Vector3(roblox.Vector3.new(100, 0, 0), 10)).toBeNil()
		end)
		it("validates dense arrays of unique integers", function()
			expect(Guard.IntegerList({ 3, 1, 3, 2 }, 8, 1, 100)).toEqual({ 3, 1, 2 })
			expect(Guard.IntegerList({ 1, 2.5 }, 8, 1, 100)).toBeNil()
			expect(Guard.IntegerList({ [1] = 1, [3] = 3 }, 8, 1, 100)).toBeNil()
			expect(Guard.IntegerList({ 1, 2, x = 3 }, 8, 1, 100)).toBeNil()
			expect(Guard.IntegerList({ 1, 2, 3 }, 2, 1, 100)).toBeNil()
			expect(Guard.IntegerList("1,2", 8, 1, 100)).toBeNil()
			expect(Guard.IntegerList({}, 8, 1, 100)).toEqual({})
		end)
	end)

	describe("RateLimiter", function()
		it("allows a burst then refills over time", function()
			local now = 0
			local limiter = RateLimiter.new(3, 2, function()
				return now
			end)
			local key = {}
			expect(limiter:Allow(key)).toBe(true)
			expect(limiter:Allow(key)).toBe(true)
			expect(limiter:Allow(key)).toBe(true)
			expect(limiter:Allow(key)).toBe(false)
			now = 0.5 -- +1 token
			expect(limiter:Allow(key)).toBe(true)
			expect(limiter:Allow(key)).toBe(false)
			now = 10 -- refills to capacity, never beyond
			expect(limiter:Peek(key)).toBeNear(3)
		end)
		it("tracks keys independently and supports costs and resets", function()
			local now = 0
			local limiter = RateLimiter.new(4, 1, function()
				return now
			end)
			local a, b = {}, {}
			expect(limiter:Allow(a, 4)).toBe(true)
			expect(limiter:Allow(a)).toBe(false)
			expect(limiter:Allow(b)).toBe(true)
			limiter:Reset(a)
			expect(limiter:Allow(a)).toBe(true)
		end)
	end)
end
