-- Shared utilities: number formatting, geometry, zones, signals, cleanup.

return function(t)
	local describe, it, expect = t.describe, t.it, t.expect
	local roblox = require("@lune/roblox")
	local task = require("@lune/task")
	local Vector3 = roblox.Vector3
	local loader = t.loader()
	local GameConfig = loader:require("src/ReplicatedStorage/Source/Configuration/GameConfig.luau")
	local NumberFormat = loader:require("src/ReplicatedStorage/Source/Shared/NumberFormat.luau")
	local Spatial = loader:require("src/ReplicatedStorage/Source/Shared/Spatial.luau")
	local Zones = loader:require("src/ReplicatedStorage/Source/Shared/Zones.luau")
	local Signal = loader:require("src/ReplicatedStorage/Source/Shared/Signal.luau")
	local Trove = loader:require("src/ReplicatedStorage/Source/Shared/Trove.luau")

	describe("NumberFormat", function()
		it("abbreviates large numbers", function()
			expect(NumberFormat.Abbreviate(950)).toBe("950")
			expect(NumberFormat.Abbreviate(1.25)).toBe("1.25")
			expect(NumberFormat.Abbreviate(15320)).toBe("15.32K")
			expect(NumberFormat.Abbreviate(1000000)).toBe("1M")
			expect(NumberFormat.Abbreviate(999999)).toBe("1M")
			expect(NumberFormat.Abbreviate(2.5e12)).toBe("2.5T")
			expect(NumberFormat.Abbreviate(-4200)).toBe("-4.2K")
			expect(NumberFormat.Abbreviate(0 / 0)).toBe("0")
		end)
		it("formats commas, multipliers, percents and durations", function()
			expect(NumberFormat.Commas(1234567)).toBe("1,234,567")
			expect(NumberFormat.Commas(999)).toBe("999")
			expect(NumberFormat.Multiplier(2.5)).toBe("x2.5")
			expect(NumberFormat.Multiplier(1)).toBe("x1")
			expect(NumberFormat.Percent(0.345)).toBe("34.5%")
			expect(NumberFormat.Seconds(75)).toBe("1:15")
			expect(NumberFormat.Seconds(8)).toBe("8s")
		end)
	end)

	describe("Spatial", function()
		local origin = Vector3.new(0, 3, 0)
		local forward = Vector3.new(0, 0, -1)
		local halfAngle = math.rad(45 / 2)

		it("hits targets inside the Ground Lash cone", function()
			expect(Spatial.InCone(origin, forward, Vector3.new(0, 3, -13), 14, halfAngle, 0)).toBe(true)
			expect(Spatial.InCone(origin, forward, Vector3.new(0, 3, -15), 14, halfAngle, 0)).toBe(false)
			expect(Spatial.InCone(origin, forward, Vector3.new(0, 3, 5), 14, halfAngle, 0)).toBe(false)
			-- 30 degrees off-axis is outside a 45-degree (22.5 half-angle) spread...
			local offAxis = Vector3.new(math.sin(math.rad(30)) * 10, 3, -math.cos(math.rad(30)) * 10)
			expect(Spatial.InCone(origin, forward, offAxis, 14, halfAngle, 0)).toBe(false)
			-- ...unless the target is wide enough to overlap the cone edge.
			expect(Spatial.InCone(origin, forward, offAxis, 14, halfAngle, 2)).toBe(true)
		end)
		it("respects the vertical tolerance", function()
			expect(Spatial.InCone(origin, forward, Vector3.new(0, 20, -5), 14, halfAngle, 0, 12)).toBe(false)
			expect(Spatial.InRadius(origin, Vector3.new(11, 3, 0), 12, 0, 12)).toBe(true)
			expect(Spatial.InRadius(origin, Vector3.new(13, 3, 0), 12, 0, 12)).toBe(false)
			expect(Spatial.InRadius(origin, Vector3.new(13, 3, 0), 12, 1.5, 12)).toBe(true)
		end)
		it("computes signed yaw", function()
			expect(Spatial.YawBetween(Vector3.new(0, 0, -1), Vector3.new(-1, 0, 0))).toBeNear(math.pi / 2, 1e-6)
		end)
	end)

	describe("Zones", function()
		it("maps positions to eras and modes", function()
			expect(Zones.EraAt(Vector3.new(0, 0, 0))).toBe(1)
			expect(Zones.EraAt(Vector3.new(319, 0, 0))).toBe(1)
			expect(Zones.EraAt(Vector3.new(320, 0, 0))).toBe(2)
			expect(Zones.EraAt(Vector3.new(1400, 0, 0))).toBe(4)
			expect(Zones.EraAt(Vector3.new(-9999, 0, 0))).toBe(1)
			expect(Zones.ModeAt(GameConfig.World.ColosseumCenter)).toBe("Combat")
			expect(Zones.ModeAt(GameConfig.World.ObeliskPosition)).toBe("Training")
			expect(Zones.PortalIntoEra(2).Id).toBe("RiftToJapan")
			expect(Zones.PortalIntoEra(1)).toBeNil()
		end)
	end)

	describe("Signal", function()
		it("connects, fires, disconnects and supports Once/Wait", function()
			local signal = Signal.new()
			local received = {}
			local connection = signal:Connect(function(value)
				table.insert(received, value)
			end)
			local onceCount = 0
			signal:Once(function()
				onceCount += 1
			end)
			signal:Fire(1)
			signal:Fire(2)
			connection:Disconnect()
			signal:Fire(3)
			expect(received).toEqual({ 1, 2 })
			expect(onceCount).toBe(1)
			expect(signal:ConnectionCount()).toBe(0)

			local waited = nil
			task.spawn(function()
				waited = signal:Wait()
			end)
			signal:Fire("ready")
			expect(waited).toBe("ready")
		end)
		it("isolates handler errors from other listeners", function()
			local signal = Signal.new()
			local reached = false
			signal:Connect(function()
				error("intentional handler failure (Signal isolation test)")
			end)
			signal:Connect(function()
				reached = true
			end)
			pcall(function()
				signal:Fire()
			end)
			expect(reached).toBe(true)
		end)
	end)

	describe("Trove", function()
		it("releases everything newest-first, once", function()
			local trove = Trove.new()
			local order = {}
			trove:Add(function()
				table.insert(order, "first")
			end)
			trove:Add({
				Destroy = function()
					table.insert(order, "destroyable")
				end,
			})
			trove:Add({
				Disconnect = function()
					table.insert(order, "connection")
				end,
			})
			trove:Clean()
			trove:Clean()
			expect(order).toEqual({ "connection", "destroyable", "first" })
		end)
	end)
end
